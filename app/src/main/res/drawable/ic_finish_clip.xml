<?xml version="1.0" encoding="utf-8"?>
<!-- Tinted programmatically by the overlay views, so no tint attribute here.
     Done with a clip opened from a flow: an arrow rising out of an open tray, back into the container it
     came from. Deliberately unlike ic_close's X — the two sit in the same column and mean very different
     things, one leaving a clip and one turning the whole toolbar off. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The tray: the flow being returned to. Open at the top, which is where the arrow leaves. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5,13v5a2,2 0 0,0 2,2h10a2,2 0 0,0 2,-2v-5h-2v5H7v-5z" />
    <!-- The arrow: this clip, on its way back up into it. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,3l-4.5,4.5 1.4,1.4L11,6.8V15h2V6.8l2.1,2.1 1.4,-1.4z" />
</vector>
