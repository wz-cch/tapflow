    <string name="action_pause">暫停</string>
    <string name="action_resume">繼續</string>
    <string name="action_stop">停止</string>
    <string name="action_record">錄製</string>
    <string name="action_record_resume">繼續錄製</string>
    <string name="action_record_stop">停止錄製</string>
    <string name="action_insert_pause">插入暫停點</string>
    <string name="action_undo">復原上一步</string>
    <string name="action_add_tap">新增點擊點</string>
    <string name="action_delete">刪除選取</string>
    <string name="action_edit_mode">編輯模式</string>
    <string name="action_save">儲存為片段</string>
    <string name="action_density">標記顯示密度</string>
    <string name="action_collapse">摺疊</string>
    <string name="action_dismiss">收起工具列</string>

