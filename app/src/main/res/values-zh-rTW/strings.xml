<?xml version="1.0" encoding="utf-8"?>
<!--
  正體中文(台灣)。預設語系(英文)在 values/strings.xml。
  新增字串時請兩邊一起加,並保持 key 順序一致以便對照。
-->
<resources>

    <!-- App 與無障礙服務 -->
    <string name="app_name">觸控流</string>
    <string name="service_label">觸控流 — 錄製與重播</string>
    <string name="accessibility_summary">錄製你的觸控操作並自動重播</string>
    <string name="accessibility_description">開啟後,觸控流才能在螢幕上顯示懸浮工具列、錄製你的觸控軌跡,並在重播時代替你點擊與滑動。本服務不會讀取畫面內容,也不會連線網路。</string>

    <!-- 步驟描述。座標為整數,時間單位為毫秒。 -->
    <string name="step_tap">點擊 (%1$d, %2$d)</string>
    <string name="step_long_press">長按 (%1$d, %2$d) · %3$d ms</string>
    <string name="step_swipe">滑動 (%1$d, %2$d) → (%3$d, %4$d) · %5$d ms</string>
    <string name="step_multi_touch">%1$d 指手勢 · %2$d ms</string>
    <string name="step_wait">等待 %1$d ms</string>
    <string name="step_global">系統動作:%1$s</string>
    <string name="step_pause">⏸ 暫停點</string>
    <string name="step_pause_with_note">⏸ 暫停點:%1$s</string>
    <string name="pause_default_prompt">已暫停,請手動處理後按繼續</string>

    <!-- 系統動作 -->
    <string name="global_back">返回</string>
    <string name="global_home">主畫面</string>
    <string name="global_recents">最近應用</string>
    <string name="global_notifications">通知欄</string>

    <!-- 文字比對方式 -->
    <string name="match_contains">包含</string>
    <string name="match_exact">完全相符</string>
    <string name="match_view_id">元件 ID</string>

    <!-- 標記顯示密度 -->
    <string name="density_all">顯示全部</string>
    <string name="density_recent">只顯示最近</string>
    <string name="density_hidden">隱藏</string>

