    <string name="transport_loop">輪 %1$d/%2$d</string>
    <string name="transport_loop_infinite">輪 %1$d/∞</string>
    <string name="transport_step">步 %1$d/%2$d</string>
    <string name="transport_countdown">%1$d…</string>
