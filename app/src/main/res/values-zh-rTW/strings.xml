    <string name="node_await_text">等待畫面出現「%1$s」</string>

    <!-- 片段 -->
    <string name="clip_default_name">錄製 %1$s</string>

    <!-- 工具列按鍵。會當成無障礙描述使用,請保持簡短。 -->
