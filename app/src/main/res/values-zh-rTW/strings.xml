    <string name="warn_toolbar_area">此區域無法錄製,請拖走工具列</string>
    <string name="warn_rotation_changed">錄製中螢幕轉向,已中止錄製。座標系會對不上。</string>
    <string name="warn_clip_rotation">此片段錄製於不同方向,請轉回原方向後按繼續。</string>
    <string name="warn_clip_scaled">座標已依錄製時的螢幕尺寸換算</string>
    <string name="warn_unsaved">工作區有未儲存的變更</string>

    <!-- 權限引導 -->
    <string name="onboarding_accessibility_title">開啟無障礙服務</string>
    <string name="onboarding_accessibility_body">觸控流需要無障礙服務才能顯示工具列、錄製你的觸控並重播。大多數裝置只要開這一個開關。</string>
    <string name="onboarding_accessibility_action">前往無障礙設定</string>
    <string name="onboarding_overlay_title">允許顯示在其他應用上層</string>
    <string name="onboarding_overlay_body">只是備援:部分 ROM 會擋掉無障礙懸浮視窗。真的掛不上去時,觸控流才會請你開這個權限。</string>
    <string name="onboarding_overlay_action">前往懸浮視窗設定</string>
    <string name="onboarding_service_ready">無障礙服務運行中</string>

    <!-- 主畫面 -->
    <string name="home_show_toolbar">顯示懸浮工具列</string>
    <string name="home_tab_clips">片段</string>
    <string name="home_tab_flows">流程</string>
    <string name="home_no_clips">還沒有片段。打開工具列、按錄製,操作一次看看。</string>
    <string name="home_no_flows">還沒有流程。把存好的片段串成流程,就能一次跑完。</string>
    <string name="clip_summary">%1$d 個動作 · 約 %2$s</string>
    <string name="clip_summary_with_pauses">%1$d 個動作 · %2$d 個暫停點 · 約 %3$s</string>

    <!-- 設定 -->
    <string name="settings_title">設定</string>
    <string name="settings_reset">恢復預設值</string>

</resources>
