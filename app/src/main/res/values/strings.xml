    <string name="quick_title">Quick settings</string>
    <string name="quick_on">ON</string>
    <string name="quick_off">OFF</string>
    <string name="quick_full_settings">All settings in the app →</string>

    <!-- Settings -->
    <string name="settings_title">Settings</string>
    <string name="settings_reset">Restore defaults</string>
    <string name="settings_section_defaults">Defaults for new actions</string>
    <string name="settings_default_gap">Gap between actions</string>
    <string name="settings_default_tap">Tap hold time</string>
    <string name="settings_default_swipe">Swipe duration</string>
    <string name="settings_section_playback">Playback</string>
    <string name="settings_loop_count">Repeat count</string>
    <string name="settings_loop_forever">Until stopped</string>
    <string name="settings_speed">Speed</string>
    <string name="settings_start_delay">Countdown before starting</string>
    <string name="settings_section_randomise">Randomisation</string>
    <string name="settings_jitter_radius">Position jitter radius</string>
    <string name="settings_jitter_radius_body">Offsets the whole gesture by a random amount within this radius on each replay. Also stops every run hitting the exact same pixel.</string>
    <string name="settings_jitter_time">Timing jitter</string>
    <string name="settings_section_recording">Recording</string>
    <string name="settings_replay_each">Replay each gesture</string>
    <string name="settings_replay_each_body">Sends every recorded gesture straight back to the app underneath so the screen moves on. Turn it off for blind recording, where the screen never changes but fast swipes stay accurate.</string>
    <string name="settings_replay_delay">Wait after replaying</string>
    <string name="settings_avoid_obscuring">Move the overlay aside to replay</string>
    <string name="settings_avoid_obscuring_body">For apps that ignore taps while recording. Some apps discard any touch arriving under an overlay, which makes the replayed gesture do nothing; this parks the overlay off screen for each one. Leave it off unless you need it — moving the window on every gesture is intrusive and has been seen to shift the markers on some devices.</string>
    <string name="settings_section_appearance">Appearance</string>
    <string name="settings_ui_scale">Toolbar size</string>
    <string name="settings_ui_opacity">Toolbar opacity</string>
    <string name="settings_show_timer">Show timer</string>
    <string name="settings_show_markers_idle">Keep markers on screen</string>
    <string name="settings_show_markers_idle_body">Shows the numbered markers while idle and during playback, not just while recording or editing. Leave this off unless you need it: painting them requires a full-screen overlay, and some apps discard every touch that arrives through one — they stop responding to your own finger too.</string>
    <string name="settings_section_screen">Screen</string>
    <string name="settings_keep_screen_on">Keep screen on</string>
    <string name="settings_keep_screen_on_body">Injected gestures do nothing once the screen turns off.</string>
    <string name="settings_dim">Black out while replaying</string>
    <string name="settings_dim_body">The screen stays on, it just shows nothing. Only useful for leaving something running. Needs a full-screen overlay, so apps that discard obscured touches will ignore the replay while this is on.</string>
    <string name="settings_dim_alpha">Blackout strength</string>
    <string name="value_ms">%1$d ms</string>
    <string name="value_px">%1$d px</string>
    <string name="value_percent">%1$d%%</string>
    <string name="value_times">%1$d×</string>
    <string name="value_multiplier">%1$s×</string>

