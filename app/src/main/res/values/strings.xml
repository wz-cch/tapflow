    <string name="transport_countdown">%1$d…</string>
    <string name="transport_recording">Recording · %1$d actions</string>

    <!-- Warnings shown on the canvas or in the editor -->
    <string name="warn_toolbar_area">This area cannot be recorded — drag the toolbar away</string>
    <string name="warn_rotation_changed">Screen rotated during recording, so recording stopped. Coordinates would not line up.</string>
    <string name="warn_clip_rotation">This clip was recorded in a different orientation. Rotate the device, then press resume.</string>
    <string name="warn_clip_scaled">Coordinates rescaled from the recorded screen size</string>
    <string name="warn_unsaved">The workspace has unsaved changes</string>

    <!-- Permission onboarding -->
    <string name="onboarding_accessibility_title">Enable the accessibility service</string>
    <string name="onboarding_accessibility_body">TapFlow needs the accessibility service to show its toolbar, record your touches, and replay them. This is the only switch most devices need.</string>
    <string name="onboarding_accessibility_action">Open accessibility settings</string>
    <string name="onboarding_overlay_title">Allow display over other apps</string>
    <string name="onboarding_overlay_body">Only needed as a fallback: some ROMs block accessibility overlays. TapFlow will ask for this if and when its toolbar fails to attach.</string>
    <string name="onboarding_overlay_action">Open overlay settings</string>
    <string name="onboarding_service_ready">Accessibility service is running</string>
    <string name="onboarding_service_stalled_title">Accessibility service is not running</string>
    <string name="onboarding_service_error_title">The service failed to start</string>
    <string name="onboarding_service_error_body">TapFlow is switched on in accessibility settings, but the service threw an error while starting up, so turning it off and on again will not help. Please send the line below — it says exactly what failed.</string>
    <string name="onboarding_service_stalled_body">TapFlow is switched on in accessibility settings, but Android has not restarted the service. This usually happens after the app is swiped off the recents list or force stopped.\n\nTry switching TapFlow off and back on in accessibility settings. If that does not help, this device is holding the app in a stopped state: exclude TapFlow from battery optimisation and allow it to auto-start, or reinstall it. Nothing inside the app can force Android to bind the service.\n\nYou can turn the toolbar on below already — it will appear as soon as the service reconnects.</string>

    <!-- Home screen -->
    <string name="home_show_toolbar">Show floating toolbar</string>
    <string name="home_tab_clips">Clips</string>
    <string name="home_tab_flows">Flows</string>
    <string name="home_no_clips">No clips yet. Turn on the toolbar, press record, and do something.</string>
    <string name="home_no_flows">No flows yet. Chain saved clips into a flow to run them in one go.</string>
    <string name="clip_summary">%1$d actions · about %2$s</string>
    <string name="clip_summary_with_pauses">%1$d actions · %2$d pause points · about %3$s</string>

    <!-- Toasts raised from the overlay -->
    <string name="toast_saved">Saved as “%1$s”</string>
    <string name="toast_nothing_to_save">Nothing recorded yet</string>
    <string name="toast_pause_inserted">Pause point inserted — do this step by hand, then press record again</string>
    <string name="toast_undone">Last step removed</string>
    <string name="toast_loaded">Loaded “%1$s” into the workspace</string>
    <string name="toast_toolbar_hidden">Toolbar hidden. Turn it back on in the TapFlow app.</string>
    <string name="toast_overlay_failed">Could not show the toolbar. This device may need the display-over-other-apps permission.</string>
    <string name="toast_gesture_refused">The system would not accept the gesture. The coordinates may be off screen, or another gesture is still running.</string>
    <string name="toast_gesture_cancelled">The gesture was cancelled part way. This usually means the app on screen rejects injected or obscured touches, which cannot be worked around without root.</string>
    <string name="toast_replay_echo">The overlay did not step aside in time and swallowed the replayed gesture. Turn on “Move the overlay aside to replay” in quick settings.</string>
    <string name="home_version">version %1$s</string>

