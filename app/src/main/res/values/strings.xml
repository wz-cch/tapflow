<?xml version="1.0" encoding="utf-8"?>
<!--
  Default locale: English.
  Traditional Chinese lives in values-zh-rTW/strings.xml.

  Every string the user can read must be declared here. Nothing user-facing may be hard-coded in
  Kotlin, including strings drawn on the overlay views.
-->
<resources>

    <!-- App and accessibility service -->
    <string name="app_name">TapFlow</string>
    <string name="service_label">TapFlow — record and replay</string>
    <string name="accessibility_summary">Record your touches and replay them automatically</string>
    <string name="accessibility_description">TapFlow needs this to show its floating toolbar, record your touch paths, and tap and swipe on your behalf during replay. It does not read screen contents and never connects to the network.</string>

    <!-- Step labels. Coordinates are integers, durations are milliseconds. -->
    <string name="step_tap">Tap (%1$d, %2$d)</string>
    <string name="step_long_press">Long press (%1$d, %2$d) · %3$d ms</string>
    <string name="step_swipe">Swipe (%1$d, %2$d) → (%3$d, %4$d) · %5$d ms</string>
    <string name="step_multi_touch">%1$d-finger gesture · %2$d ms</string>
    <string name="step_wait">Wait %1$d ms</string>
    <string name="step_global">System action: %1$s</string>
    <string name="step_pause">⏸ Pause point</string>
    <string name="step_pause_with_note">⏸ Pause point: %1$s</string>
    <string name="pause_default_prompt">Paused — finish by hand, then press resume</string>

    <!-- Global actions -->
    <string name="global_back">Back</string>
    <string name="global_home">Home</string>
    <string name="global_recents">Recents</string>
    <string name="global_notifications">Notification shade</string>

